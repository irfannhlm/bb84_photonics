# ========================================================
# BB84 Alice -> Bob: bit transcript from the time-domain run
# ========================================================
# Run after the alice_bob simulation. For every bit slot it reads Alice's basis/bit and
# Bob's basis from the drive oscilloscopes, integrates Bob's two outputs over ONE gate
# centred on the main pulse, decides Bob's bit, sifts, and writes a CSV + summary.
#
# Gating: both detectors share the same gate, centred on the total-power peak of the slot.
# Gating each detector on its own peak makes the dark detector integrate the ~5.4 ns
# echo (S-parameter filter artifact) instead of the empty slot -> ER drops to 10-20 dB.
#
# Channels: the optical oscilloscopes are noise-free, so they give the device ER.
# The APD outputs (OSC_1/OSC_2) include receiver noise: fine for bit decisions, but the
# dark-detector energy sits at the noise floor (often <= 0), so their ER is meaningless.
#
# Detector 0 = Bob output 0 (bit 0), detector 1 = Bob output 1 (bit 1).
# Python cross-check / figure: plot_timing.py (reads alice_bob.ich).

# ---------------- settings ----------------
use_optical      = 1;        # 1: OSC_Output_Bob_0/1 (optical), 0: OSC_2/OSC_1 (APD, noisy)
gate_width       = 1e-9;     # s, full gate width (SPAD-like)
v_logic          = 0.6;      # V, threshold on the 0 / 1.2 V drive signals
min_contrast_dB  = 10;       # matched slots below this are flagged LOW_CONTRAST
max_imbalance_dB = 3;        # mismatched slots above this are flagged IMBALANCED
manual_bit_shift = 0;        # extra slot offset between drives and Bob outputs

bit_rate   = getnamed("::Root Element", "bitrate");
bit_period = 1 / bit_rate;
filename   = "BB84_transcript_" + num2str(bit_rate / 1e6) + "Mbps.csv";

# ---------------- read signals ----------------
sig_basis_alice = getresult("OSC_Basis_Alice", "signal");
sig_bit_alice   = getresult("OSC_Bit_Alice", "signal");
sig_basis_bob   = getresult("OSC_Basis_Bob", "signal");
t_in            = sig_basis_alice.time;
basis_alice_v   = sig_basis_alice.getattribute("amplitude (a.u.)");
bit_alice_v     = sig_bit_alice.getattribute("amplitude (a.u.)");
basis_bob_v     = sig_basis_bob.getattribute("amplitude (a.u.)");

if (use_optical) {
    sig_0 = getresult("OSC_Output_Bob_0", "sum/signal");
    sig_1 = getresult("OSC_Output_Bob_1", "sum/signal");
    channel = "optical";
} else {
    sig_0 = getresult("OSC_2", "signal");
    sig_1 = getresult("OSC_1", "signal");
    channel = "APD";
}
# first (only) attribute of the dataset, whatever the oscilloscope calls it
attr_0 = splitstring(getattribute(sig_0), "\n");
attr_1 = splitstring(getattribute(sig_1), "\n");
t_out = sig_0.time;
p_0   = sig_0.getattribute(attr_0{1});
p_1   = sig_1.getattribute(attr_1{1});
p_tot = p_0 + p_1;
dt    = t_out(2) - t_out(1);

# ---------------- timing reference: first pulse at Bob ----------------
idx_thresh = find(p_tot > 0.3 * max(p_tot));
if (length(idx_thresh) == 0) {
    ?"No pulse above threshold at Bob's outputs - check the simulation.";
    idx_thresh = 1;
}
idx_end = min([idx_thresh(1) + round(bit_period / dt), length(t_out)]);
sub = p_tot(idx_thresh(1):idx_end);
idx_peak = find(sub == max(sub));
t_first = t_out(idx_thresh(1) + idx_peak(1) - 1);
?"First pulse at Bob: t = " + num2str(t_first * 1e9) + " ns  (channel: " + channel + ")";

# ---------------- counters ----------------
num_bits = floor(max(t_in) / bit_period);
n_slots = 0;  n_matched = 0;  n_bit_err = 0;  n_low = 0;  n_imb = 0;
worst_imbalance = 0;  worst_imbalance_slot = 0;
# per Alice state, index = 2*basis + bit + 1  ->  H, V, -45, +45
state_name = cell(4);
state_name{1} = "H   (basis 0, bit 0)";
state_name{2} = "V   (basis 0, bit 1)";
state_name{3} = "-45 (basis 1, bit 0)";
state_name{4} = "+45 (basis 1, bit 1)";
state_count = [0, 0, 0, 0];
state_min   = [1e9, 1e9, 1e9, 1e9];
state_sum   = [0, 0, 0, 0];
state_slot  = [0, 0, 0, 0];

if (fileexists(filename)) { rm(filename); }
write(filename, "slot,alice_basis,alice_bit,bob_basis,energy0_J,energy1_J,bob_bit,contrast_dB,basis_match,status");

# ---------------- per-slot extraction ----------------
for (i = 1:num_bits) {
    # drives, sampled mid-slot
    t_s = (i - 0.5) * bit_period;
    k = find(abs(t_in - t_s) == min(abs(t_in - t_s)));
    k = k(1);
    basis_a = basis_alice_v(k) > v_logic;
    bit_a   = bit_alice_v(k) > v_logic;
    basis_b = basis_bob_v(k) > v_logic;

    # expected pulse centre, refined to the total-power peak within +-T/8 (echo is ~T/4 later)
    t_c = t_first + (i - 1 + manual_bit_shift) * bit_period;
    if (t_c - bit_period / 8 >= 0 and t_c + bit_period / 8 <= max(t_out)) {
        idx_win = find(t_out >= t_c - bit_period / 8 and t_out <= t_c + bit_period / 8);
        sub = p_tot(idx_win);
        idx_peak = find(sub == max(sub));
        t_c = t_out(idx_win(1) + idx_peak(1) - 1);

        # one gate for both detectors
        idx_gate = find(t_out >= t_c - gate_width / 2 and t_out <= t_c + gate_width / 2);
        e_0 = integrate(p_0(idx_gate), 1, t_out(idx_gate));
        e_1 = integrate(p_1(idx_gate), 1, t_out(idx_gate));
        n_slots = n_slots + 1;

        bit_b = e_1 > e_0;
        e_lo = min([abs(e_0), abs(e_1)]);
        if (e_lo > 0) { contrast = 10 * log10(max([e_0, e_1]) / e_lo); } else { contrast = 100; }

        if (basis_a == basis_b) {
            match = "MATCHED";
            n_matched = n_matched + 1;
            status = "OK";
            if (bit_b != bit_a) {
                status = "BIT_ERROR";
                n_bit_err = n_bit_err + 1;
            } else if (contrast < min_contrast_dB) {
                status = "LOW_CONTRAST";
                n_low = n_low + 1;
            }
            s = 2 * basis_a + bit_a + 1;
            state_count(s) = state_count(s) + 1;
            state_sum(s) = state_sum(s) + contrast;
            if (contrast < state_min(s)) { state_min(s) = contrast; state_slot(s) = i; }
        } else {
            # mismatched basis: Bob's bit is random and the slot is discarded at sifting
            match = "MISMATCHED";
            status = "SIFTED_OUT";
            if (contrast > max_imbalance_dB) {
                status = "SIFTED_OUT_IMBALANCED";
                n_imb = n_imb + 1;
            }
            if (contrast > worst_imbalance) { worst_imbalance = contrast; worst_imbalance_slot = i; }
        }

        write(filename, num2str(i) + "," + num2str(basis_a) + "," + num2str(bit_a) + "," +
              num2str(basis_b) + "," + num2str(e_0) + "," + num2str(e_1) + "," + num2str(bit_b) + "," +
              num2str(contrast) + "," + match + "," + status);
    }
}

# ---------------- summary ----------------
?"======================================================================";
?" BB84 transcript summary  (" + num2str(bit_rate / 1e6) + " Mbps, " + channel +
 " channel, " + num2str(gate_width * 1e9) + " ns gate)";
?"======================================================================";
?"Slots evaluated        : " + num2str(n_slots);
?"Matched basis (sifted) : " + num2str(n_matched) + "  (" + num2str(round(100 * n_matched / n_slots)) + " %)";
?"Bit errors (matched)   : " + num2str(n_bit_err) + "  (" + num2str(100 * n_bit_err / max([n_matched, 1])) + " %)";
?"Low contrast (< " + num2str(min_contrast_dB) + " dB) : " + num2str(n_low);
?"----------------------------------------------------------------------";
?"Matched-basis ER per Alice state      count   min (dB)   mean (dB)   worst slot";
for (s = 1:4) {
    if (state_count(s) > 0) {
        ?"  " + state_name{s} + "      " + num2str(state_count(s)) + "      " +
         num2str(state_min(s)) + "      " + num2str(state_sum(s) / state_count(s)) + "      " + num2str(state_slot(s));
    }
}
?"----------------------------------------------------------------------";
?"Mismatched basis: worst split imbalance " + num2str(worst_imbalance) + " dB (slot " +
 num2str(worst_imbalance_slot) + "), " + num2str(n_imb) + " slots above " + num2str(max_imbalance_dB) + " dB";
if (use_optical == 0) {
    ?"Note: APD channel - ER values are set by the receiver noise floor, not by the chip.";
}
?"Written: " + filename;
