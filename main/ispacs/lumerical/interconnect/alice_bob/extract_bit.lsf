# --- Skrip Lumerical Auto-Sync Pro (Pulse Signal Mode) ---

# 1. Get Data from Oscilloscopes
sig_basis_alice = getresult("OSC_Basis_Alice", "signal");
sig_bit_alice   = getresult("OSC_Bit_Alice", "signal");
sig_basis_bob   = getresult("OSC_Basis_Bob", "signal");

sig_out_0 = getresult("OSC_1", "signal"); 
sig_out_1 = getresult("OSC_2", "signal");

# 2. Ekstrak Waktu & Amplitudo
t_in  = sig_basis_alice.time;
t_out = sig_out_0.time;       

amp_basis_alice = sig_basis_alice.getattribute("amplitude (a.u.)");
amp_bit_alice   = sig_bit_alice.getattribute("amplitude (a.u.)");
amp_basis_bob   = sig_basis_bob.getattribute("amplitude (a.u.)");

attr_optik = "amplitude (a.u.)";
amp_out_0 = sig_out_0.getattribute(attr_optik);
amp_out_1 = sig_out_1.getattribute(attr_optik);

# ==========================================
# SETUP GLOBAL & KALIBRASI
# ==========================================
manual_bit_shift = 0; 
bit_rate   = 50e6; 
bit_period = 1 / bit_rate;  # Dipindah ke scope global
# ==========================================

# 3. Deteksi Puncak Pulsa Pertama (Local Peak Detection)
total_power = amp_out_0 + amp_out_1;
max_tot_power = max(total_power);

t_first_pulse_center = 0;

# Ambang batas awal untuk mendeteksi kehadiran pulsa pertama
idx_thresh = find(total_power > 0.3 * max_tot_power); 

if (length(idx_thresh) > 0) {
    idx_start = idx_thresh(1);
    
    # Hitung jumlah sampel dalam 1 periode bit
    dt = t_out(2) - t_out(1);
    samples_per_bit = round(bit_period / dt);
    
    # Batasi pencarian puncak hanya di dalam window pulsa pertama
    idx_end = idx_start + samples_per_bit;
    if (idx_end > length(t_out)) { idx_end = length(t_out); }
    
    # Cari nilai maksimum (puncak) di dalam window tersebut
    sub_power = total_power(idx_start:idx_end);
    max_sub_power = max(sub_power);
    idx_local_peak = find(sub_power == max_sub_power);
    
    # Tentukan indeks dan waktu puncak pulsa pertama
    idx_first_peak = idx_start + idx_local_peak(1) - 1;
    t_first_pulse_center = t_out(idx_first_peak);
    
    print("Puncak pulsa pertama terdeteksi pada t = " + num2str(t_first_pulse_center) + " s");
} else {
    print("Warning: Tidak ada pulsa cahaya yang terdeteksi di atas threshold!");
}

num_bits = floor(max(t_in) / bit_period);

# 4. CSV File Generation
filename = "Transkrip_BB84_100Mbps.csv";
if (fileexists(filename)) { rm(filename); } 

# Ditambahkan '\n' untuk pemisah baris CSV
write(filename, "Bit_Ke, Bit_Alice, Basis_Alice, Basis_Bob, Bit0_Bob, Bit1_Bob, Bit_Bob\n");

# 5. Sampling per Bit
for (i=1:num_bits) {
    # --- A. Sampling Input Elektrik (Tengah Periode Bit) ---
    t_sample_in = (i - 0.5) * bit_period;

    idx_in = find(abs(t_in - t_sample_in) == min(abs(t_in - t_sample_in)));
    idx_in = idx_in(1); 

    val_basis_alice = 0; if (amp_basis_alice(idx_in) > 0.6) { val_basis_alice = 1; }
    val_bit_alice   = 0; if (amp_bit_alice(idx_in) > 0.6)   { val_bit_alice = 1; }
    val_basis_bob   = 0; if (amp_basis_bob(idx_in) > 0.6)   { val_basis_bob = 1; }

    # --- B. Sampling Output Optik (Tepat di Puncak Pulsa) ---
    idx_optik = i + manual_bit_shift;

    power_0 = 0; power_1 = 0; bit_bob = "";

    if (idx_optik >= 1) {
        # Posisi puncak bit ke-i dihitung dari puncak bit ke-1 + kelipatan interval
        t_sample_out = t_first_pulse_center + (idx_optik - 1) * bit_period;

        if (t_sample_out <= max(t_out)) {
            idx_out = find(abs(t_out - t_sample_out) == min(abs(t_out - t_sample_out)));
            idx_out = idx_out(1);

            power_0 = amp_out_0(idx_out);
            power_1 = amp_out_1(idx_out);

            # Logika Keputusan BB84
            if ((power_0 + power_1) < 0.1 * max_tot_power) {
                bit_bob = "Error/No Signal";
            } else if (power_0 > 3 * power_1) {
                bit_bob = "0";
            } else if (power_1 > 3 * power_0) {
                bit_bob = "1";
            } else {
                bit_bob = "x";
            }
        } else {
            bit_bob = "Habis";
        }
    } else {
        bit_bob = "Belum Mulai";
    }

    # 6. Write to CSV (Ditambahkan '\n' di akhir)
    str_line = num2str(i) + ", " + 
               num2str(val_bit_alice) + ", " + 
               num2str(val_basis_alice) + ", " + 
               num2str(val_basis_bob) + ", " + 
               num2str(power_0) + ", " + 
               num2str(power_1) + ", " + 
               bit_bob;

    write(filename, str_line);
}

print("File " + filename + " selesai dibuat!");